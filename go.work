go 1.25.3

// Goose framework (local development)
use ../../awesome-goose/goose

use (
	./libs/ai
	./libs/blobs
	./libs/core
	./libs/design
	./libs/flags
	./libs/polylog
	./libs/render
	./libs/spec
)

// Workspace-only overrides so local development resolves to the in-tree copies
// before tags exist. These are not used by consumers of the published modules.
replace github.com/thescaffold/gox-packages/libs/core v0.0.7 => ./libs/core
replace github.com/thescaffold/gox-packages/libs/design v0.0.1 => ./libs/design
